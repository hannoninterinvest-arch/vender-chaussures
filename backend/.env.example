# Back NestJS — copier ce fichier vers .env
#   cp backend/.env.example backend/.env

# PostgreSQL (Neon). Retirer channel_binding=require si présent (node-pg ne le gère pas).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Port de l’API
PORT=3001

# Origine CORS du front Next.js (* = toutes les origines)
FRONTEND_URL=*

# Clé de l’espace vendeur (/vendeur)
SELLER_KEY=kicks-vendeur

# Cloudinary — upload des photos produit (max 5), le lien HTTPS est stocké en PostgreSQL
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
