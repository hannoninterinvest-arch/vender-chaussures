# Back NestJS — copier ce fichier vers .env
#   cp backend/.env.example backend/.env

# PostgreSQL (Neon). Retirer channel_binding=require si présent (node-pg ne le gère pas).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Port de l’API
PORT=3001

# Origine CORS du front Next.js. Pour Flouci, mets l’URL réelle de la boutique
# (pas *), sinon la redirection après paiement ne marchera pas.
FRONTEND_URL=http://localhost:3000

# JWT des sessions staff (obligatoire en production)
JWT_SECRET=change-moi-en-production

# Premier admin créé seulement si la table users est vide
ADMIN_EMAIL=admin@kicks.tn
ADMIN_PASSWORD=KicksAdmin123
ADMIN_NAME=Administrateur

# Premier vendeur (optionnel, table vide uniquement)
VENDEUR_EMAIL=vendeur@kicks.tn
VENDEUR_PASSWORD=Vendeur123
VENDEUR_NAME=Vendeur

# Cloudinary — upload des photos produit (max 5), le lien HTTPS est stocké en PostgreSQL
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Flouci — paiement en ligne (wallet + cartes tunisiennes et internationales)
# Dashboard : Accepter en ligne → API → Public Token / Private Token
# Docs : https://docs.flouci.com
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
# Alias possibles : FLOUCI_APP_TOKEN / FLOUCI_APP_SECRET
# URL publique de l’API (webhook Flouci). Sur Render : https://TON-SERVICE.onrender.com
BACKEND_PUBLIC_URL=http://localhost:3001

# TODO: clé exchangerate-api.com pour GET /currency (sinon open.er-api.com + table de repli)
# EXCHANGE_RATE_API_KEY=

