# Back NestJS — copier ce fichier vers .env
#   cp backend/.env.example backend/.env

# PostgreSQL (Neon). Retirer channel_binding=require si présent (node-pg ne le gère pas).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Port de l’API
PORT=3001

# Origine CORS du front Next.js. Pour Konnect, mets l’URL réelle de la boutique
# (pas *), sinon la redirection après paiement ne marchera pas.
FRONTEND_URL=http://localhost:3000

# JWT des sessions staff (obligatoire en production)
JWT_SECRET=change-moi-en-production

# Premier admin créé seulement si la table users est vide
ADMIN_EMAIL=admin@kicks.tn
ADMIN_PASSWORD=KicksAdmin123
ADMIN_NAME=Administrateur

# Premier vendeur (optionnel, table vide uniquement)
VENDEUR_EMAIL=vendeur@kicks.tn
VENDEUR_PASSWORD=Vendeur123
VENDEUR_NAME=Vendeur

# Cloudinary — photos produit + vidéos 3D (accueil / fiche produit)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Konnect — paiement en ligne (carte, e-DINAR, wallet, Flouci)
# Dashboard sandbox : https://dashboard.sandbox.konnect.network
# Dashboard production : https://dashboard.konnect.network
# KONNECT_API_KEY a le format walletId:secret (header x-api-key)
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# true = préprod Konnect, false = production
KONNECT_SANDBOX=true
# Optionnel : wallet,bank_card,e-DINAR,flouci
# KONNECT_METHODS=wallet,bank_card,e-DINAR,flouci
# URL publique de l’API (webhook Konnect). Sur Render : https://TON-SERVICE.onrender.com
BACKEND_PUBLIC_URL=http://localhost:3001

