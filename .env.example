# Front Next.js — copier ce fichier vers .env.local
#   cp .env.example .env.local

# API Nest sur Render. Avec /api à la fin (sinon le login fait 404).
# Exemple : https://vender-chaussures.onrender.com/api
NEXT_PUBLIC_API_URL=https://vender-chaussures.onrender.com/api

# Si le back est aussi sur Vercel (2e projet, Root Directory = backend) :
# NEXT_PUBLIC_API_URL=https://TON-API.vercel.app/api

# Seulement si tu lances aussi le back en local (npm run dev:api) :
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
