# Application unique Next.js — copier vers .env.local pour le développement.
# Toutes ces variables sont privées : aucun préfixe NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
# URL canonique de la boutique, sans / final. HTTPS en production.
APP_URL=http://localhost:3000
# Secret aléatoire, au moins 32 caractères. Garder l'ancien secret pour conserver les sessions.
JWT_SECRET=
# Utilisés uniquement par npm run db:init si aucun compte n'existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur
# Vendeur initial facultatif.
VENDEUR_EMAIL=
VENDEUR_PASSWORD=
VENDEUR_NAME=Vendeur

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Créés par npm run cloudinary:init. Presets signés avec limites de format et taille.
CLOUDINARY_IMAGE_UPLOAD_PRESET=kicks_images_signed
CLOUDINARY_MODEL_UPLOAD_PRESET=kicks_models_signed

# Flouci API v2. Utiliser les clés adaptées à l'environnement test/production.
FLOUCI_PUBLIC_KEY=
FLOUCI_SECRET_KEY=
# Konnect facultatif. false pour la production.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_SANDBOX=true
# KONNECT_METHODS=wallet,bank_card,e-DINAR
# IPAPI_KEY=
# EXCHANGE_RATE_API_KEY=

# Aramex — API de devis international. Toutes les clés sont privées.
# Identifiants API fournis par Aramex pour votre compte expéditeur tunisien.
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=
ARAMEX_ORIGIN_CITY=
ARAMEX_ORIGIN_POSTAL_CODE=
ARAMEX_ORIGIN_ADDRESS=
# false = production, true = plateforme de test Aramex.
ARAMEX_SANDBOX=false
# Type de service de votre contrat (PPX = colis express prioritaire).
ARAMEX_PRODUCT_TYPE=PPX
# JSON des cartons finaux réellement utilisés, une entrée par capacité.
# Laisser vide tant que leurs dimensions ne sont pas mesurées.
# Exemple de FORMAT uniquement : [{"maxPairs":1,"lengthCm":35,"widthCm":25,"heightCm":15},{"maxPairs":2,"lengthCm":40,"widthCm":30,"heightCm":20}]
# Remplacer toutes les dimensions par vos mesures réelles, en centimètres.
ARAMEX_PACKAGING_RULES=
