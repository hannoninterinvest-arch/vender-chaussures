# Front Next.js — copier ce fichier vers .env.local
#   cp .env.example .env.local

# API Nest sur Render (pas localhost). Sans slash final.
# Dashboard Render → ton Web Service → copie l’URL, puis ajoute /api
NEXT_PUBLIC_API_URL=https://vender-chaussures-api.onrender.com/api

# Si le back est aussi sur Vercel (2e projet, Root Directory = backend) :
# NEXT_PUBLIC_API_URL=https://TON-API.vercel.app/api

# Seulement si tu lances aussi le back en local (npm run dev:api) :
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
